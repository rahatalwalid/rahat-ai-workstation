{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rahat-ai-workstation",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rahat-ai-db",
      "database_id": "d053c3c4-2fd3-4ca1-82a7-af2ec82e3844"
    }
  ],
  "observability": {
    "enabled": true
  }
}
